{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'github>synthe102/homelab//.renovate/customManagers.json5',
  ],
  packageRules: [
    {
      description: 'Automerge patch and minor updates',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Disable automerge for Talos packages',
      matchPackageNames: ['ghcr.io/siderolabs/talosctl', 'ghcr.io/siderolabs/installer'],
      automerge: false,
    },
    {
      description: 'Keep the NVMe-oF gateway on 1.x while the cluster runs Ceph 20.x (tentacle); 2.0 is built for Ceph 21 (umbrella) and crashloops without mon-side gateway registration',
      matchPackageNames: ['quay.io/ceph/nvmeof'],
      allowedVersions: '<2.0.0',
    },
  ],
  argocd: {
    managerFilePatterns: [
      '/clusters/k8s-01/apps/.*\\.yaml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/clusters/k8s-01/apps/.*\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/clusters/k8s-01/apps/.*\\.yaml$/',
    ],
  },
}
